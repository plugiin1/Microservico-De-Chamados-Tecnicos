# Copie para .env na raiz do projeto. O .env e ignorado pelo Git.
# Atencao: variaveis de ambiente do sistema operacional tem precedencia sobre este arquivo.
# Se existir um MONGODB_URI definido no Windows, e ele que vale e este arquivo e ignorado.

MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=thindesk
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@thindesk.local
ADMIN_PASSWORD=TroqueEstaSenha123!
SESSION_TIMEOUT=30m
COOKIE_SECURE=false
APP_NOME=Thindesk
APP_TEMA=padrao
CHAMADOS_PORT=8081
CHAMADOS_API_URL=http://localhost:8081
CHAMADOS_API_KEEP_ALIVE=false
